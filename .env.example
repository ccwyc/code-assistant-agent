# ============================================================================
# 代码辅助开发 Agent · 环境变量模板
# 复制为 .env 后填写自己的 Key：cp .env.example .env   （Windows: copy .env.example .env）
# ============================================================================

# ---------------------------------------------------------------- 模型（必填）
# DeepSeek 开放平台：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# OpenAI 兼容地址；接中转/硅基流动等服务时改这里
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
# 长对话摘要使用的模型（留空则复用 DEEPSEEK_MODEL）
DEEPSEEK_SUMMARY_MODEL=
TEMPERATURE=0.2
MAX_TOKENS=4096
REQUEST_TIMEOUT=120

# ---------------------------------------------------------------- 可观测（可选）
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=code-assistant-agent
# 自建 LangSmith 时填写，例如 https://api.smith.langchain.com
LANGSMITH_ENDPOINT=

# ---------------------------------------------------------------- Agent 行为
# 代码校验失败后的最大修正次数
MAX_VALIDATION_RETRIES=2
# 单次请求最大模型调用次数 / 校验工具调用次数（防死循环、天然限流）
MAX_MODEL_CALLS_PER_RUN=12
MAX_TOOL_CALLS_PER_RUN=8
# 长对话摘要（SummarizationMiddleware）
ENABLE_SUMMARIZATION=true
SUMMARIZATION_TRIGGER_TOKENS=8000
SUMMARIZATION_KEEP_MESSAGES=12

# ---------------------------------------------------------------- 接口层
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=*
MAX_MESSAGE_CHARS=20000
MAX_CONCURRENT_REQUESTS=8
LOG_LEVEL=INFO
